{
  "name": "@cacheplane/source",
  "version": "0.0.0",
  "private": true,
  "description": "Cacheplane monorepo: streaming parsers and shared infrastructure.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "bench:json": "pnpm --filter @cacheplane/json-stream build && pnpm --filter @cacheplane/partial-json build && node tools/bench-json.mjs",
    "bench:json:compare": "node tools/bench-json-compare.mjs",
    "bench:markdown": "pnpm --filter @cacheplane/partial-markdown build && node tools/bench-markdown.mjs",
    "bench:markdown:compare": "node tools/bench-markdown-compare.mjs",
    "check:partial-json-package": "node tools/check-partial-json-package.mjs",
    "test": "pnpm -r --workspace-concurrency=1 --filter './packages/*' test && node --test tools/bench-json.test.mjs",
    "test:coverage": "pnpm -r --workspace-concurrency=1 --filter './packages/*' test:coverage",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:partial-json-package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "publint": "^0.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
