{
  "name": "@cacheplane/json-stream",
  "version": "0.0.4",
  "description": "Streaming incremental JSON parser with push/pull APIs, node guards, and JSON Pointer resolution.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "attw": "attw --pack ."
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/cacheplane.git",
    "directory": "packages/json-stream"
  },
  "homepage": "https://github.com/cacheplane/cacheplane/tree/main/packages/json-stream#readme",
  "bugs": "https://github.com/cacheplane/cacheplane/issues",
  "keywords": [
    "json",
    "stream",
    "partial",
    "parser",
    "incremental",
    "llm"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
